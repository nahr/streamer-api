# Table TV configuration - copy to table-tv.config and customize
# cp /etc/table-tv/table-tv.config.example /etc/table-tv/table-tv.config

port = 8080
sqlite_path = "/var/lib/table-tv/table-tv.db"
ui_dist_path = "/usr/share/table-tv/ui-dist"

# Optional: fixed token for RTMP pipeline
# stream_token = "your-secret-token"

# MediaMTX (for RTSP cameras). playback_url and rtsp_host derived from api_url.
[mediamtx]
# api_url = "http://127.0.0.1:9997"
# rtsp_port = "8554"
